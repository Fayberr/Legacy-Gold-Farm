{
  "schemaVersion": 1,
  "id": "legacy_gold_farm",
  "version": "${version}",
  "name": "Legacy Gold Farm",
  "description": "Configurable legacy zombified piglin mechanics for gold farms.",
  "authors": [
    "Fayber"
  ],
  "license": "GPL-3.0-or-later",
  "environment": "*",
  "mixins": [
    "legacy_gold_farm.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "${minecraft_range}",
    "java": ">=25"
  },
  "entrypoints": {
    "main": [
      "dev.fayber.legacygoldfarm.LegacyGoldFarm"
    ],
    "modmenu": [
      {
        "value": "dev.fayber.legacygoldfarm.compat.LegacyGoldFarmModMenu",
        "adapter": "default"
      }
    ]
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*",
    "modernconfig": "*"
  },
  "contact": {
    "sources": "https://github.com/Fayberr/Legacy-Gold-Farm",
    "issues": "https://github.com/Fayberr/Legacy-Gold-Farm/issues"
  }
}
